{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/**"
    }
  },
  "crons": [
    { "path": "/api/scheduled/weekly-challenge", "schedule": "0 18 * * 0" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
